# Copy this file to .env and fill in your own values.

# Port the backend API server runs on
PORT=5000

# Long random string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=my_super_secret_jwt_key_12345

# Your Anthropic API key (starts with sk-ant-...). Get one at https://console.anthropic.com/
# This key stays on the server and is never sent to the browser.
GEMINI_API_KEY=AQ.Ab8RN6KDWr1Ijv_6_fTuWg_cItxl8Z9mIaH3n6pXiCRW_r_s-g
# Comma-separated list of frontend origins allowed to call this API.
# The Vite dev server defaults to http://localhost:5173
CORS_ORIGIN=http://localhost:5173
